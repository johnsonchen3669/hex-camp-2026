---
const withBase = (path: string) =>
  `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}${path.replace(/^\//, "")}`;
---

<footer>
  <!-- ===== CONTACT ===== -->
  <section id="contact" class="bg-primary-900 py-20">
    <div class="container">
      <div class="flex flex-col gap-12 lg:grid lg:grid-cols-[40%_1fr] lg:gap-20">
        <div class="flex flex-col gap-3 md:gap-6">
          <div>
            <p class="text-sm/normal font-bold text-neutral-0 sm:text-base">與我聯絡</p>
            <h2 class="text-10/tight font-bold text-neutral-0 lg:text-20/tight">CONTACT</h2>
          </div>
          <p class="text-sm/normal text-neutral-0 sm:text-base">
            若有數位產品設計和開發相關問題<br />
            歡迎這裡查看 或 直接與我聯絡！
          </p>
        </div>

        <form class="flex flex-col gap-4 lg:row-span-2" onsubmit="return false;">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <input
              type="text"
              placeholder="姓名"
              class="h-16 rounded-full border border-neutral-0 bg-transparent px-6 text-sm text-neutral-0 placeholder:text-neutral-0 outline-none focus:border-primary-500"
            />
            <input
              type="tel"
              placeholder="手機號碼"
              class="h-16 rounded-full border border-neutral-0 bg-transparent px-6 text-sm text-neutral-0 placeholder:text-neutral-0 outline-none focus:border-primary-500"
            />
          </div>
          <input
            type="email"
            placeholder="電子信箱"
            class="h-16 rounded-full border border-neutral-0 bg-transparent px-6 text-sm text-neutral-0 placeholder:text-neutral-0 outline-none focus:border-primary-500"
          />
          <textarea
            placeholder="備註"
            rows="4"
            class="resize-none rounded-3xl border border-neutral-0 bg-transparent p-6 text-sm text-neutral-0 placeholder:text-neutral-0 outline-none focus:border-primary-500"
          ></textarea>
          <button
            type="submit"
            class="h-16 w-full rounded-full bg-neutral-0 text-sm font-bold text-primary-900 transition-all duration-300 hover:bg-primary-500"
          >
            送出
          </button>
        </form>

        <div class="flex flex-col gap-3 lg:self-end">
          <div class="flex gap-3">
            <!-- Instagram -->
            <a
              href="#"
              aria-label="Instagram"
              class="flex size-11 items-center justify-center rounded-full border border-neutral-0/40 text-neutral-0 transition-all duration-300 hover:border-primary-500 hover:text-primary-500 sm:size-12"
            >
              <svg class="size-5 sm:size-6" viewBox="0 0 24 24" fill="currentColor">
