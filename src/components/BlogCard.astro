---
interface Props {
  tags: string[];
  title: string;
  date: string;
  views: string | number;
  shares: string | number;
  image: string;
  href?: string;
  class?: string;
}

const {
  tags,
  title,
  date,
  views,
  shares,
  image,
  href = '#',
  class: className = '',
} = Astro.props;
---

<a href={href} class={`group flex flex-col ${className}`.trim()}>
  <div class="aspect-416/240 overflow-hidden">
    <img
      src={image}
      alt={title}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="flex flex-col gap-2 pt-2 md:gap-3 md:pt-3">
    <p class="text-sm/normal md:text-base/normal">{tags.join(' · ')}</p>
    <h3 class="line-clamp-3 text-xl/normal font-bold transition-colors group-hover:text-primary-900 md:text-2xl/normal">
      {title}
    </h3>
    <div class="flex items-center justify-between gap-4 text-3.25/normal sm:text-sm/normal">
      <span class="max-w-19.75 md:max-w-none">{date}</span>
      <div class="flex items-center gap-2 md:gap-3">
        <span class="flex items-center gap-1">
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
