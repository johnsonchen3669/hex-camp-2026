---
import BaseLayout from "../layouts/BaseLayout.astro";

const withBase = (path: string) =>
  `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}${path.replace(/^\//, "")}`;

const services = [
  {
    en: "GRAPHIC",
    zh: "平面設計",
    active: true,
    icon: `<path d="M8.3279 1.93207L9.05686 1.16663L18.8098 10.9494L12.3037 17.5364L5.79792 10.9294L11.575 5.18897L8.3279 1.93207ZM12.3239 5.94046L7.27002 10.9697H17.3377L12.3239 5.94046ZM19.786 17.3998C19.4826 17.0952 19.3308 16.7208 19.3308 16.2765C19.3308 15.9619 19.4133 15.6514 19.5781 15.3449C19.743 15.0384 19.9163 14.748 20.0981 14.4739C20.2287 14.2902 20.3612 14.1114 20.4958 13.9372C20.6304 13.7629 20.7671 13.584 20.9059 13.4003C21.0445 13.584 21.181 13.7629 21.3156 13.9372C21.4502 14.1114 21.5828 14.2902 21.7136 14.4739C21.8952 14.748 22.0685 15.0384 22.2333 15.3449C22.3983 15.6514 22.4809 15.9619 22.4809 16.2765C22.4809 16.7208 22.329 17.0952 22.0254 17.3998C21.7218 17.7042 21.3486 17.8564 20.9059 17.8564C20.4629 17.8564 20.0896 17.7042 19.786 17.3998ZM3.5 24.5V22.3935H24.5V24.5H3.5Z"/>`,
  },
  {
    en: "WEBSITE",
    zh: "網頁設計",
    active: false,
    icon: `<path d="M18.0833 18.3076H21.8076V14.5833H20.7757V17.2757H18.0833V18.3076ZM6.19237 11.0833H7.22429V8.39092H9.91667V7.359H6.19237V11.0833ZM10.5 23.3333V21H3.5V4.66663H24.5V21H17.5V23.3333H10.5ZM4.66667 19.8333H23.3333V5.83329H4.66667V19.8333Z"/>`,
  },
  {
    en: "FRONTEND",
    zh: "前端切版",
    active: false,
    icon: `<path d="M3.5 22.1667V5.83337H24.5V22.1667H3.5ZM4.66667 21H17.5V16.4681H4.66667V21ZM18.6667 21H23.3333V10.7692H18.6667V21ZM4.66667 15.3015H17.5V10.7692H4.66667V15.3015Z"/>`,
  },
  {
    en: "BACKEND",
    zh: "後端開發",
    active: false,
    icon: `<path d="M4.6665 23.3333V4.66663H23.3332V23.3333H4.6665ZM5.83317 10.4976H22.1665V5.83329H5.83317V10.4976ZM5.83317 16.3356H22.1665V11.6643H5.83317V16.3356ZM5.83317 22.1666H22.1665V17.5023H5.83317V22.1666ZM7.8973 9.10434V7.21988H9.78175V9.10434H7.8973ZM7.8973 14.9423V13.0576H9.78175V14.9423H7.8973ZM7.8973 20.78V18.8956H9.78175V20.78H7.8973Z"/>`,
  },
];

const steps = [
  {
    num: "1",
    title: "需求訪談與視覺定位",
    body: "深度溝通品牌核心價值，確認目標受眾與視覺風格，制定符合商業邏輯的設計藍圖。",
  },
  {
    num: "2",
    title: "概念發展與方案提案",
    body: "將抽象概念具象化，提供多層次的設計提案，確保視覺語言精準傳遞品牌獨特魅力。",
  },
  {
    num: "3",
    title: "匠心編排與細節校正",
    body: "針對初稿進行多輪細緻微調，優化排版層次與色彩表現，追求美學與易讀性的完美平衡。",
  },
  {
    num: "4",
    title: "專業檔案交付結案",
    body: "提供完整原始碼與多樣格式輸出，並附上使用規範建議，確保品牌形象在各處始終如一。",
  },
];

const cases = [
  {
    tags: ["平面設計", "網頁設計"],
    date: "Oct 16, 2022",
    title: "品牌視覺與電商整合，多肉植物品牌電商建置",
    body: "從品牌識別設計到 RWD 響應式網站開發，打造療癒系植栽購物體驗",
    image: withBase("/image/project_1.png"),
  },
  {
    tags: ["平面設計", "網頁設計", "前端切版"],
    date: "Oct 16, 2022",
    title: "數位產品 UI/UX 設計，個人化財務視覺化軟體",
    body: "運用數據視覺化邏輯，將複雜的財務數據轉化為直覺的個人化操作介面",
    image: withBase("/image/project_2.png"),
  },
];

const faqs = [
  {
    num: "01",
    q: "設計提案後包含幾次修改機會？",
    a: "標準專案包含三輪修改，每輪針對您的反饋進行調整。若需額外修改，可依實際工作量另行報價，確保最終成果完全符合您的期待。",
  },
  {
    num: "02",
    q: "結案時我會收到哪些格式的檔案？",
    a: "依服務類型而定：平面設計提供 AI、PDF、PNG、JPG 等格式；網頁設計提供 Figma 原始檔與規範文件；前端切版則提供完整原始碼與部署說明。",
  },
  {
    num: "03",
    q: "平面設計的成果，未來能直接應用在網頁嗎？",
    a: "沒問題。由於我兼具 UI/UX 設計與前端工程背景，在執行平面設計時會預先考量數位載體的適配性。這意味著您的品牌識別能無縫轉譯至網頁介面，不僅節省後續開發的重複溝通，更能確保品牌在不同平台上的視覺品質。",
  },
  {
    num: "04",
    q: "完成一套完整的設計流程需要多久？",
    a: "視專案複雜度而定，一般約需 10 到 14 個工作日。透過嚴格執行的「四步驟流程」，我們能確保每個階段都有明確的進度產出，有效避免時程延宕。若有特定的上線期限，歡迎在訪談階段提出，我會為您評估最合適的排程。",
  },
];
---

<BaseLayout title="服務項目 | Nelson">
  <main>
    <!-- ===== HERO ===== -->
    <section class="relative overflow-hidden bg-primary-900">
      <img
        src={withBase("/image/mobile/service_banner.png")}
        alt=""
        aria-hidden="true"
        class="absolute inset-0 h-full w-full object-cover object-top md:hidden"
      />
      <img
        src={withBase("/image/service_banner.png")}
        alt=""
        aria-hidden="true"
        class="absolute inset-0 hidden h-full w-full object-cover object-top md:block"
      />
      <div class="absolute inset-0 bg-black/60"></div>
      <div class="relative container-narrow flex flex-col gap-6 py-10 md:gap-10 md:py-20 md:justify-between">
        <!-- Title -->
        <div class="text-center">
          <h1 class="text-10/tight font-bold text-neutral-0 sm:text-20/tight">SERVICES</h1>
          <p class="text-10/tight font-bold text-neutral-0 sm:text-12/tight">服務項目</p>
        </div>
        <!-- Service Tabs -->
        <div class="grid grid-cols-2 gap-3 md:gap-6 lg:grid-cols-4">
          {
            services.map((s) => (
              <div
                class={`flex flex-col items-center justify-center gap-3 py-4 px-3 text-center md:p-8 ${
                  s.active
                    ? "bg-primary-900 text-neutral-0"
                    : "bg-neutral-0"
                }`}
              >
                <svg
                  class="size-7 shrink-0"
                  viewBox="0 0 28 28"
                  fill="currentColor"
                  aria-hidden="true"
                  set:html={s.icon}
                />
                <div>
                  <p class="text-sm/normal font-bold sm:text-base">{s.en}</p>
                  <p class="text-2xl/normal font-bold sm:text-7/normal">{s.zh}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ===== SERVICE STEPS ===== -->
    <section class="bg-primary-900 py-10 md:py-20">
      <div class="container-narrow">
        <div class="grid gap-6 lg:grid-cols-[416px_1fr]">
          <!-- Left: title -->
          <div class="flex flex-col items-center lg:items-start">
            <p class="text-sm/normal font-bold text-neutral-0 sm:text-base">SERVICE STEPS</p>
            <h2 class="text-10/tight font-bold text-neutral-0 lg:text-12/tight">服務流程</h2>
          </div>
          <!-- Right: steps -->
          <div class="flex flex-col">
            {
              steps.map((step, i) => (
                <div class="flex gap-6">
                  <!-- number + line -->
                  <div class="flex flex-col items-center">
                    <div class="flex size-9 shrink-0 items-center justify-center rounded-full bg-neutral-0 sm:size-10">
                      <span class="text-sm/normal font-medium sm:text-base/normal">{step.num}</span>
                    </div>
                    {i < steps.length - 1 && (
                      <div class="w-[0.5px] flex-1 bg-neutral-0" />
                    )}
                  </div>
                  <!-- content -->
                  <div class={`flex flex-col gap-3 ${i < steps.length - 1 ? "pb-10" : ""}`}>
                    <h3 class="text-6/normal font-bold text-neutral-0 sm:text-7/normal">{step.title}</h3>
                    <p class="text-sm/normal text-neutral-0 sm:text-base/normal">{step.body}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ===== USER CASE ===== -->
    <section class="bg-neutral-0 py-10 md:py-20">
      <div class="container-narrow">
        <div class="mb-10">
          <p class="text-sm/normal font-bold sm:text-base">USER CASE</p>
          <h2 class="text-10/tight font-bold lg:text-12/tight">客戶案例</h2>
        </div>
        <div class="grid gap-6 sm:grid-cols-2">
          {
            cases.map((c) => (
              <article class="flex flex-col gap-3">
                <div class="overflow-hidden">
                  <img
                    src={c.image}
                    alt={c.title}
                    class="aspect-526/306 w-full object-cover transition-transform duration-500 hover:scale-105"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="flex flex-col-reverse gap-1 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
                  <p class="text-sm/normal sm:text-base/normal">{c.tags.join(" · ")}</p>
                  <span class="text-3.25/normal shrink-0 sm:text-sm/normal">{c.date}</span>
                </div>
                <h3 class="text-xl/normal font-bold sm:text-2xl/normal">{c.title}</h3>
                <div class="flex items-center justify-between gap-3">
                  <p class="text-sm/normal sm:text-base/normal">{c.body}</p>
                  <a
                    href={withBase("/project")}
                    aria-label={`查看${c.title}專案`}
                    class="flex size-11 shrink-0 items-center justify-center rounded-full bg-neutral-700 text-neutral-0 transition-all duration-300 hover:bg-primary-500 hover:-translate-y-0.5 active:translate-y-0 md:size-12"
                  >
                    <svg class="size-5 md:size-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M6.70085 18L6 17.2991L16.2616 7.01794H6.80265V6H18V17.1974H16.9821V7.73839L6.70085 18Z" />
                    </svg>
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ===== FAQ ===== -->
    <section class="py-10 md:py-20">
      <div class="container-narrow">
        <div class="grid gap-10 lg:grid-cols-[416px_1fr] lg:gap-6">
          <!-- Left: title -->
          <div>
            <p class="text-sm/normal font-bold sm:text-base">FAQ</p>
            <h2 class="text-10/tight font-bold lg:text-12/tight">常見問題</h2>
          </div>
          <!-- Right: accordion -->
          <div class="flex flex-col">
            {
              faqs.map((faq) => (
                <details class="group faq-item -mt-px border-y border-primary-900 first:mt-0">
                  <summary class="flex cursor-pointer list-none items-center gap-4 p-6">
                    <span class="w-8 shrink-0 text-lg/normal font-bold">{faq.num}</span>
                    <span class="flex-1 text-base/normal font-bold sm:text-lg/normal">{faq.q}</span>
                    <svg
                      class="size-6 shrink-0 transition-transform duration-300 group-open:rotate-180"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M12 15.0006L6 9.00059L7.4 7.60059L12 12.2006L16.6 7.60059L18 9.00059L12 15.0006Z" />
                    </svg>
                  </summary>
                  <div class="faq-content grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out">
                    <div class="min-h-0 overflow-hidden">
                      <p class="px-6 pb-6 text-sm/normal sm:text-base/normal">{faq.a}</p>
                    </div>
                  </div>
                </details>
              ))
            }
          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLDetailsElement>('details.faq-item').forEach((details) => {
    const summary = details.querySelector('summary');
    const content = details.querySelector<HTMLElement>('.faq-content');

    summary?.addEventListener('click', (e) => {
      e.preventDefault();

      if (details.open) {
        // 關閉：先動畫，transitionend 後才移除 open
        content?.classList.replace('grid-rows-[1fr]', 'grid-rows-[0fr]');
        content?.addEventListener('transitionend', () => {
          details.open = false;
        }, { once: true });
      } else {
        // 開啟：先設 open 讓內容進入渲染樹，下一個 rAF 再觸發動畫
        details.open = true;
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            content?.classList.replace('grid-rows-[0fr]', 'grid-rows-[1fr]');
          });
        });
      }
    });
  });
</script>
