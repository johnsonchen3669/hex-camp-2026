---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppButton from '../components/AppButton';
import ProjectCard from '../components/ProjectCard.astro';
import BlogCard from '../components/BlogCard.astro';

const withBase = (path: string) =>
  `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${path.replace(/^\//, '')}`;

const services = [
  {
    en: 'GRAPHIC',
    zh: '平面設計',
    body: '從品牌識別到視覺傳達，用專業設計精準傳遞核心價值',
    icon: `<path d="M8.3279 1.93207L9.05686 1.16663L18.8098 10.9494L12.3037 17.5364L5.79792 10.9294L11.575 5.18897L8.3279 1.93207ZM12.3239 5.94046L7.27002 10.9697H17.3377L12.3239 5.94046ZM19.786 17.3998C19.4826 17.0952 19.3308 16.7208 19.3308 16.2765C19.3308 15.9619 19.4133 15.6514 19.5781 15.3449C19.743 15.0384 19.9163 14.748 20.0981 14.4739C20.2287 14.2902 20.3612 14.1114 20.4958 13.9372C20.6304 13.7629 20.7671 13.584 20.9059 13.4003C21.0445 13.584 21.181 13.7629 21.3156 13.9372C21.4502 14.1114 21.5828 14.2902 21.7136 14.4739C21.8952 14.748 22.0685 15.0384 22.2333 15.3449C22.3983 15.6514 22.4809 15.9619 22.4809 16.2765C22.4809 16.7208 22.329 17.0952 22.0254 17.3998C21.7218 17.7042 21.3486 17.8564 20.9059 17.8564C20.4629 17.8564 20.0896 17.7042 19.786 17.3998ZM3.5 24.5V22.3935H24.5V24.5H3.5Z"/>`,
  },
  {
    en: 'WEBSITE',
    zh: '網頁設計',
    body: '美感易用並重，以 Figma 打造符合直覺的數位體驗',
    icon: `<path  d="M18.0833 18.3076H21.8076V14.5833H20.7757V17.2757H18.0833V18.3076ZM6.19237 11.0833H7.22429V8.39092H9.91667V7.359H6.19237V11.0833ZM10.5 23.3333V21H3.5V4.66663H24.5V21H17.5V23.3333H10.5ZM4.66667 19.8333H23.3333V5.83329H4.66667V19.8333Z"/>`,
  },
  {
    en: 'FRONTEND',
    zh: '前端切版',
    body: '精準轉譯設計稿細節，建構流暢穩定 RWD 響應式網頁',
    icon: `<path d="M3.5 22.1667V5.83337H24.5V22.1667H3.5ZM4.66667 21H17.5V16.4681H4.66667V21ZM18.6667 21H23.3333V10.7692H18.6667V21ZM4.66667 15.3015H17.5V10.7692H4.66667V15.3015Z"/>`,
  },
  {
    en: 'BACKEND',
    zh: '後端開發',
    body: '佈署穩定系統架構，串接 API 並確保數據處理安全',
    icon: `<path  d="M4.6665 23.3333V4.66663H23.3332V23.3333H4.6665ZM5.83317 10.4976H22.1665V5.83329H5.83317V10.4976ZM5.83317 16.3356H22.1665V11.6643H5.83317V16.3356ZM5.83317 22.1666H22.1665V17.5023H5.83317V22.1666ZM7.8973 9.10434V7.21988H9.78175V9.10434H7.8973ZM7.8973 14.9423V13.0576H9.78175V14.9423H7.8973ZM7.8973 20.78V18.8956H9.78175V20.78H7.8973Z" />`,
  },
];

const projects = [
  {
    date: 'Oct 16, 2025',
    tags: ['平面設計', '網頁設計'],
    title: '品牌視覺與電商整合，多肉植物品牌電商建置',
    body: '從品牌識別設計到 RWD 網站開發，打造療癒系植栽購物體驗',
    image: withBase('/image/project_1.png'),
    mobileImage: withBase('/image/mobile/project_1.png'),
    bg: 'bg-primary-50',
  },
  {
    date: 'Oct 16, 2025',
    tags: ['平面設計', '網頁設計', '前端切版'],
    title: '數位產品 UI/UX 設計，個人化財務視覺化軟體',
    body: '運用數據視覺化邏輯，將複雜的財務數據轉化為直覺的操作介面',
    image: withBase('/image/project_2.png'),
    mobileImage: withBase('/image/mobile/project_2.png'),
    bg: 'bg-primary-50',
  },
  {
    date: 'Oct 16, 2025',
    tags: ['前端切版', '後端開發'],
    title: '品牌識別與包裝設計，法式甜點品牌視覺重塑',
    body: '以溫暖、輕盈的視覺語言，精準定位高質感甜點市場的品牌形象',
    image: withBase('/image/project_3.png'),
    mobileImage: withBase('/image/mobile/project_3.png'),
    bg: 'bg-primary-50',
  },
];

const blogs = [
  {
    tags: ['UIUX 設計', '設計情報', '前端切版'],
    title:
      '10年職人手記：如何運用 Figma 與 Storybook 打造美感與邏輯兼具的企業級設計系統',
    date: 'Oct 16, 2022',
    views: 110,
    shares: 2,
    image: withBase('/image/blog_1.png'),
  },
  {
    tags: ['品牌設計', '平面設計', 'UIUX 設計'],
    title:
      '從平面識別到數位轉換：以「植感生活」為例，探討跨媒體品牌視覺在網頁上的精準轉譯',
    date: 'Oct 16, 2022',
    views: 110,
    shares: 2,
    image: withBase('/image/blog_2.png'),
  },
  {
    tags: ['前端切版', '後端整合', 'AI 趨勢應用'],
    title:
      '擁抱金融 App 的設計密碼：如何優化 Open Bank API 的複雜數據呈現與後端串接安全性',
    date: 'Oct 16, 2022',
    views: 110,
    shares: 2,
    image: withBase('/image/blog_3.png'),
  },
];
---

<BaseLayout title="Nelson | UIUX Designer & Front-End Engineer">
  <main>
    <!-- ===== HERO ===== -->
    <section class="relative overflow-x-hidden">
      <div class="container">
        <div class="relative py-4 h-dvh xl:py-0 xl:max-h-200">
          <div class="relative flex flex-col h-full gap-6 xl:flex-row">
            <div class="relative order-2 flex-1 w-full py-6 flex flex-col xl:justify-center xl:order-1 xl:py-0">
              <h1
                data-aos="fade-down"
                class="text-10/tight font-bold md:text-12/tight lg:text-16/tight xl:text-20/tight"
              >
                Hello
                <br />
                I&apos;m Nelson
              </h1>
              <img
                src={withBase('/image/index_decora_6.png')}
                alt=""
                aria-hidden="true"
                class="hero-decora-6 pointer-events-none absolute right-[30.667vw] top-0 h-8.5 w-28.5 sm:right-32 md:right-36 md:top-10 md:h-9.5 md:w-32 xl:hidden"
              />
              <img
                src={withBase('/image/index_decora_3.png')}
                alt=""
                aria-hidden="true"
                class="hero-decora-3-mobile pointer-events-none absolute right-4 top-10 w-18 sm:right-6 md:right-10 md:top-12 md:w-22 xl:hidden"
              />
              <p
                data-aos="fade-up"
                data-aos-delay="200"
                class="mt-4 flex max-w-md flex-col gap-1 text-sm/normal md:mt-6 md:text-base/normal"
              >
                <span>我是一個擁有 10 年經驗的 UIUX 設計師 和 前端工程師</span>
                <span>喜歡把美學和程式結合，打造一個又一個精美的網頁設計！</span
                >
              </p>
              <div
                data-aos="fade-up"
                data-aos-delay="350"
                class="mt-8 flex flex-wrap gap-3 lg:mt-15"
              >
                <AppButton href="/contact" label="與我聯絡" variant="primary" />
                <AppButton href="/project" label="我的履歷" variant="outline" />
              </div>
            </div>

            <div
              data-aos="fade-left"
              data-aos-delay="100"
              class="relative order-1 w-full h-[50vh] xl:order-2 xl:h-full xl:w-auto xl:min-w-0 xl:basis-[57.56%] xl:grow-0 xl:shrink-0"
            >
              <div
                class="relative w-full h-full overflow-hidden bg-primary-900"
              >
                <img
                  src={withBase('/image/index_person.png')}
                  alt="Nelson 人像"
                  class="h-full w-full object-cover"
                  loading="eager"
                  decoding="async"
                />
              </div>
              <img
                src={withBase('/image/index_decora_1.png')}
                alt=""
                aria-hidden="true"
                class="hero-decora-1 pointer-events-none absolute -left-13 top-14 w-24 md:-left-16 md:top-16 md:w-28 lg:-left-8 lg:top-10 lg:w-38 xl:left-[-15.95%] xl:top-[12.125%] xl:w-50"
              />
              <img
                src={withBase('/image/index_decora_2.png')}
                alt=""
                aria-hidden="true"
                class="hero-decora-2 pointer-events-none absolute right-[9.067vw] bottom-[9.867vw] size-20 md:-right-14 md:bottom-10 md:size-24 lg:-right-8 lg:top-auto lg:bottom-10 lg:size-30 xl:right-[-10.7%] xl:bottom-[10.88%] xl:size-40"
              />
            </div>
          </div>
        </div>
      </div>

      <img
        src={withBase('/image/index_decora_3.png')}
        alt=""
        aria-hidden="true"
        class="hero-decora-3-tl pointer-events-none absolute left-[4.48%] top-[7%] hidden w-35 xl:block"
      />
      <img
        src={withBase('/image/index_decora_4.png')}
        alt=""
        aria-hidden="true"
        class="hero-decora-4 pointer-events-none absolute left-[11.71%] top-[15%] hidden w-78 xl:block"
      />
      <img
        src={withBase('/image/index_decora_3.png')}
        alt=""
        aria-hidden="true"
        class="hero-decora-3-center pointer-events-none absolute bottom-[24%] left-[36.6%] hidden w-20 xl:block"
      />
      <img
        src={withBase('/image/index_decora_5.png')}
        alt=""
        aria-hidden="true"
        class="hero-decora-5 pointer-events-none absolute bottom-[10.375%] left-56 hidden w-45 xl:block xl:left-[27.23%]"
      />
      <img
        src={withBase('/image/index_decora_3.png')}
        alt=""
        aria-hidden="true"
        class="hero-decora-3-r pointer-events-none absolute top-[25.5%] right-[7.39%] hidden w-35 xl:block"
      />
    </section>

    <!-- ===== SERVICES ===== -->
    <section id="service" class="overflow-hidden bg-primary-900 py-10 md:py-20">
      <div class="container">
        <div data-aos="fade-up" class="mb-10">
          <p
            class="text-sm/normal font-bold text-neutral-0 sm:text-base/normal"
          >
            服務項目
          </p>
          <h2 class="text-10/tight font-bold text-neutral-0 lg:text-20/tight">
            SERVICES
          </h2>
        </div>
        <div
          class="flex gap-6 overflow-x-auto sm:grid sm:overflow-visible sm:grid-cols-2 lg:grid-cols-4"
        >
          {
            services.map((s, i) => (
              <article
                data-aos="fade-up"
                data-aos-delay={i * 100}
                class="flex w-65 flex-none flex-col gap-2 bg-primary-50 p-3 sm:w-auto md:gap-3 md:p-6 "
              >
                <div class="flex items-start justify-between gap-2 md:gap-3">
                  <div>
                    <p class="text-sm/normal font-bold sm:text-base">{s.en}</p>
                    <h3 class="text-2xl/normal font-bold sm:text-7/normal">
                      {s.zh}
                    </h3>
                  </div>
                  <svg
                    class="mt-1 size-6 shrink-0 md:size-7"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                    set:html={s.icon}
                  />
                </div>
                <div class="flex items-center justify-between gap-3">
                  <p class="text-sm/normal sm:text-base/normal">{s.body}</p>
                  <a
                    href={withBase('/service')}
                    aria-label={`了解${s.zh}服務`}
                    class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-neutral-700 text-neutral-0 transition-all duration-300 hover:bg-primary-500 hover hover:-translate-y-0.5 active:translate-y-0"
                  >
                    <svg
                      class="size-5 md:size-6"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M6.70085 18L6 17.2991L16.2616 7.01794H6.80265V6H18V17.1974H16.9821V7.73839L6.70085 18Z" />
                    </svg>
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ===== PROJECTS ===== -->
    <section id="project" class="py-10 md:py-20">
      <div class="container">
        <div data-aos="fade-up" class="mb-6 text-center md:mb-10">
          <p class="text-sm/normal font-bold sm:text-base/normal">專案作品</p>
          <h2 class="text-10/tight font-bold lg:text-20/tight">PROJECTS</h2>
        </div>
        <div class="flex flex-col gap-6">
          {
            projects.map((p, i) => (
              <div data-aos="fade-up" data-aos-delay={i * 100}>
                <ProjectCard
                  date={p.date}
                  tags={p.tags}
                  title={p.title}
                  desc={p.body}
                  image={p.image}
                  mobileImage={p.mobileImage}
                  bg={p.bg}
                  href="/project"
                />
              </div>
            ))
          }
        </div>
        <div class="mt-6 flex justify-center md:mt-12">
          <AppButton href="/project" label="探索更多" variant="primary" />
        </div>
      </div>
    </section>

    <!-- ===== BLOGS ===== -->
    <section id="blog" class="overflow-hidden bg-primary-50 py-20">
      <div class="container">
        <div
          data-aos="fade-up"
          class="mb-10 flex flex-wrap items-end justify-between gap-4"
        >
          <div>
            <p class="text-sm/normal font-bold sm:text-base/normal">部落格</p>
            <h2 class="text-10/tight font-bold lg:text-20/tight">BLOGS</h2>
          </div>
          <AppButton href="/article" label="探索更多" variant="outline" />
        </div>
        <div
          class="flex gap-3 overflow-x-auto md:grid md:overflow-visible md:gap-6 md:grid-cols-2 lg:grid-cols-3"
        >
          {
            blogs.map((b, i) => (
              <div
                data-aos="fade-up"
                data-aos-delay={i * 100}
                class="w-65 flex-none md:w-auto"
              >
                <BlogCard
                  tags={b.tags}
                  title={b.title}
                  date={b.date}
                  views={b.views}
                  shares={b.shares}
                  image={b.image}
                  href={withBase('/article')}
                />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ===== SUBSCRIPTION ===== -->
    <section class="relative overflow-hidden bg-primary-900">
      <div class="absolute inset-0 hidden lg:block">
        <img
          src={withBase('/image/subscription_bg.png')}
          alt=""
          aria-hidden="true"
          class="h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0 bg-black/60"></div>
      </div>
      <div
        class="container relative [--container-px:0] lg:[--container-px:var(--layout-gutter)]"
      >
        <div class="flex flex-col lg:flex-row lg:items-stretch lg:gap-6">
          <div
            data-aos="fade-right"
            class="w-full overflow-hidden lg:w-131.5 lg:flex-none"
          >
            <img
              src={withBase('/image/subscription.png')}
              alt="訂閱電子報"
              class="aspect-526/440 w-full object-cover lg:aspect-auto lg:h-full"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div data-aos="fade-left" class="relative flex-1">
            <div class="absolute inset-0 lg:hidden">
              <img
                src={withBase('/image/mobile/subscription_bg.png')}
                alt=""
                aria-hidden="true"
                class="h-full w-full object-cover"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-black/60"></div>
            </div>
            <div class="relative px-3 py-10 md:py-16 lg:px-0 lg:py-20">
              <p class="text-sm/normal font-bold text-primary-100 sm:text-base">
                電子報訂閱
              </p>
              <h2
                class="mb-3 text-10/tight font-bold text-neutral-0 md:mb-6 lg:text-16/tight xl:text-20/tight"
              >
                SUBSCRIPTION
              </h2>
              <p class="mb-6 text-sm/normal text-neutral-0 sm:text-base">
                你也在追求設計美感與技術落地的完美平衡嗎？作為資深設計師兼工程師，我深知跨領域協作的痛點。訂閱電子報，我將分享如何利用
                AI 工具提升產能！
              </p>
              <form
                class="flex h-16 items-center gap-2 rounded-full border border-neutral-0 p-2"
                onsubmit="return false;"
              >
                <input
                  type="email"
                  placeholder="電子信箱"
                  class="min-w-0 flex-1 bg-transparent px-6 text-sm text-neutral-0 placeholder:text-neutral-0 outline-none"
                />
                <button
                  type="submit"
                  class="h-full shrink-0 rounded-full bg-neutral-0 px-6 text-sm font-bold transition-all duration-300 hover:bg-primary-500"
                >
                  送出
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
