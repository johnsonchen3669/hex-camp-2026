---

<BaseLayout title="Nelson | UIUX Designer & Front-End Engineer">
  <main>
    <!-- ===== HERO ===== -->
    <section class="relative overflow-x-hidden">
      <div class="container">
        <div
          class="relative min-h-[calc(100dvh-var(--site-header-height))] py-4 lg:py-0"
        >
          <div class="relative flex flex-col items-center gap-6 lg:flex-row">
            <div
              class="order-2 w-full max-w-136 py-6 lg:order-1 lg:py-0 lg:pl-14"
            >
              <h1
                class="text-10/tight font-bold md:text-12/tight lg:text-16/tight xl:text-20/tight"
              >
                Hello
                <br />
                I&apos;m Nelson
              </h1>
              <p
                class="mt-4 flex max-w-md flex-col gap-1 text-sm/normal md:mt-6 md:text-base/normal"
              >
                <span>我是一個擁有 10 年經驗的 UIUX 設計師 和 前端工程師</span>
                <span>喜歡把美學和程式結合，打造一個又一個精美的網頁設計！</span
                >
              </p>
              <div class="mt-8 flex flex-wrap gap-3 lg:mt-15">
                <a
                  href="/article"
                  class="inline-flex min-h-11 items-center justify-center rounded-full bg-neutral-700 px-6 text-sm font-bold text-neutral-0 transition-all duration-300 hover:bg-primary-500 hover:text-neutral-900 hover:shadow-[0_4px_14px_rgba(245,184,123,0.45)] hover:-translate-y-0.5 active:translate-y-0 active:shadow-none"
                >
                  與我聯絡
                </a>
                <a
                  href="/project"
                  class="inline-flex min-h-11 items-center justify-center rounded-full border border-neutral-700 px-6 text-sm font-bold text-neutral-700 transition-all duration-300 hover:bg-neutral-700 hover:text-neutral-0 hover:shadow-md hover:-translate-y-0.5 active:translate-y-0 active:shadow-none"
                >
                  我的履歷
                </a>
              </div>
            </div>

            <div class="relative order-1 lg:order-2 lg:min-w-0 lg:flex-1">
              <div
                class="relative mx-auto aspect-4/5 w-full max-w-86 overflow-hidden bg-primary-900 md:max-w-104 lg:max-w-132 xl:max-w-156"
              >
                <img
                  src="/image/index_person.png"
                  alt="Nelson 人像"
                  class="h-full w-full object-cover"
                  loading="eager"
                  decoding="async"
                />
              </div>
              <img
                src="/image/index_decora_1.png"
                alt=""
                aria-hidden="true"
                class="pointer-events-none absolute left-3 top-3 w-12 lg:left-[calc(50%-3rem)] lg:top-[12.125%] lg:w-50 xl:left-[-15.95%]"
              />
              <img
                src="/image/index_decora_2.png"
                alt=""
                aria-hidden="true"
                class="pointer-events-none absolute right-1 top-52 w-14 lg:right-6 lg:top-auto lg:bottom-[10.88%] lg:w-40 xl:right-[-10.7%]"
              />
            </div>
          </div>
        </div>
      </div>

      <img
        src="/image/index_decora_3.png"
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute left-[4.48%] top-[7%] hidden w-35 lg:block"
      />
      <img
        src="/image/index_decora_4.png"
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute left-[11.71%] top-[15%] hidden w-78 lg:block"
      />
      <img
        src="/image/index_decora_3.png"
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute bottom-[24%] left-[36.6%] hidden w-20 lg:block"
      />
      <img
        src="/image/index_decora_5.png"
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute bottom-[10.375%] left-56 hidden w-45 lg:block lg:left-[27.23%]"
      />
      <img
        src="/image/index_decora_3.png"
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute top-[25.5%] right-[7.39%] hidden w-35 lg:block"
      />
    </section>
        <!-- ===== SERVICES ===== -->
    <section id="service" class="overflow-hidden bg-primary-900 py-10 md:py-20">
      <div class="container">
        <div class="mb-10">
          <p
            class="text-sm/normal font-bold text-neutral-0 sm:text-base/normal"
          >
            服務項目
          </p>
          <h2 class="text-10/tight font-bold text-neutral-0 lg:text-20/tight">
            SERVICES
          </h2>
        </div>
        <div class="flex gap-6 overflow-x-auto lg:grid lg:grid-cols-4 lg:overflow-visible">
          {
            services.map((s) => (
              <article class="flex w-65 flex-none flex-col gap-2 bg-primary-50 p-3 md:gap-3 md:p-6 lg:w-auto">
                <div class="flex items-start justify-between gap-2 md:gap-3">
                  <div>
                    <p class="text-sm/normal font-bold text-neutral-700 sm:text-base">{s.en}</p>
                    <h3 class="text-2xl/normal font-bold text-neutral-700 sm:text-7/normal">
                      {s.zh}
                    </h3>
                  </div>
                  <svg
                    class="mt-1 size-6 shrink-0 text-neutral-700 md:size-7"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                    set:html={s.icon}
                  />
                </div>
                <div class="flex items-center justify-between gap-3">
                  <p class="text-sm/normal text-neutral-700 sm:text-base/normal">{s.body}</p>
                  <a
                    href="/service"
                    aria-label={`了解${s.zh}服務`}
                    class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-neutral-700 text-neutral-0 transition-all duration-300 hover:bg-primary-500 hover:text-neutral-900 hover:-translate-y-0.5 active:translate-y-0"
                  >
                    <svg
                      class="size-5 md:size-6"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M6.70085 18L6 17.2991L16.2616 7.01794H6.80265V6H18V17.1974H16.9821V7.73839L6.70085 18Z" />
                    </svg>
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>


  </main>
</BaseLayout>
